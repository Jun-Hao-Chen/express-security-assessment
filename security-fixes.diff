+  const tempFile = `${DATA_FILE}.${crypto.randomUUID()}.tmp`;
+  await fs.writeFile(tempFile, JSON.stringify(messages, null, 2));
+  await fs.rename(tempFile, DATA_FILE);
+}
+
+// Serialize every read-modify-write cycle. Without this, two requests can read
+// the same old array and the later write silently drops the earlier update.
+// Limitation: this lock only covers a single Node.js process.
+let dataLock = Promise.resolve();
+
+function withDataLock(task) {
+  const run = dataLock.then(() => task());
+  dataLock = run.catch(() => {});
+  return run;
+}
+
+const NAME_MAX_LENGTH = 40;
+const MESSAGE_MAX_LENGTH = 2000;
+
+// One server-side validator for create, reply, and edit. HTML maxlength is only
+// a browser hint; anyone can send a raw POST request.
+function validatePostInput(body) {
+  const name = typeof body.name === 'string' ? body.name.trim() : '';
+  const text = typeof body.message === 'string' ? body.message.trim() : '';
+
+  if (!name || !text) {
+    return { error: 'Name and message are required.' };
+  }
+
+  if (name.length > NAME_MAX_LENGTH || text.length > MESSAGE_MAX_LENGTH) {
+    return { error: 'Input is too long.' };
+  }
+
+  return { name, text };
 }
 
